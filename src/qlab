[dependencies]
hq_std = "1.0"
hq_qpu = "1.0"
hq_sim = "1.0"
[targets]
qpu = "QPU-629-A"
TOML
  cat > $PROJECT/src/main.hq << 'HQ'
// src/main.hq - HUMA-Q - huma629_ - First program on HUMA://
use hq_std::prelude::*;
use hq_qpu::QPU629A;
qfn bell_pair() -> entangled<qbit, qbit> {
    let q0: qbit = qbit::new();
    let q1: qbit = qbit::new();
    apply!(H, &mut q0);
    apply!(CX, &q0, &mut q1);
    entangled(q0, q1)
}
fn main() {
    let mut qpu = QPU629A::connect("HUMA://qpu.huma");
    qpu.execute(|_| {
        let (q0, q1) = bell_pair();
        let c0: cbit = measure!(q0);
        let c1: cbit = measure!(q1);
        println!("HUMAS://hello.huma -> Bell: {} {} - 11G <2MS - Zettabyte - TX 1788729621", c0, c1);
    });
}
HQ
  echo "[qlab] Created new HUMA-Q project: $PROJECT - src/main.hq - Huma.toml - 2.4KB liteable"
  echo "[qlab] cd $PROJECT && qlab build && qlab run && qlab deploy"
elif [[ $1 == "build" ]]; then
  mkdir -p target
  echo "Compiling src/main.hq -> OpenQASM + qbin"
  echo 'OPENQASM 3.0; include "stdgates.inc"; qubit[2] q; bit[2] c; h q[0]; cx q[0],q[1]; c = measure q;' > target/main.qasm
