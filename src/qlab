echo "[qlab] HUMA-Q Quantum Lab v1.0 - huma629_"
echo "[qlab] Target: QPU-629-A 64-Qubit - Source Capacitor TX 1788727942"
if [[ $1 == "new" ]]; then
  PROJECT=$2
  if [ -z "$PROJECT" ]; then echo "Usage: qlab new <project_name>"; exit 1; fi
  mkdir -p $PROJECT/src $PROJECT/target
  cat > $PROJECT/Huma.toml << TOML
[package]
name = "$PROJECT"
version = "1.0.0"
edition = "HQ2026"
author = "huma629_"
capacitor = "huma629_HELLOO_1788727942 - 10B QB OUT OF ORBITAL"
